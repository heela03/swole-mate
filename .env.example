# Swole Mate environment template — copy to `.env` (local) or add these in your
# host's environment-variable settings (e.g. Vercel → Project → Settings).
# The app works with NO keys at all: the plan is then built by the rules-based planner.

# Optional: AI-assisted plan drafting. Any OpenAI-compatible provider works.
# These are read server-side only and never reach the browser.

# ── Option 1: Groq (free tier, no credit card) ───────────────────────────────
# Key from https://console.groq.com/keys
AI_API_KEY=your_groq_key
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ── Option 2: Google Gemini (free tier via AI Studio) ────────────────────────
# Key from https://aistudio.google.com/apikey
# AI_API_KEY=your_gemini_key
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-flash-lite-latest
